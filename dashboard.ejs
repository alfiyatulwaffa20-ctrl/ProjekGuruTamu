<%- include('partials/header') %>
<section class="welcome-row"><div><span class="eyebrow">RUANG KERJA HARI INI</span><h2><% if (currentUser.role === 'ADMIN') { %>Produksi berjalan, transparan.<% } else if (currentUser.role === 'PROJECT_MANAGER') { %>Proyek nyata. Progres terukur.<% } else { %>Karya hari ini, portofolio esok.<% } %></h2><p><% if (currentUser.role === 'ADMIN') { %>Pantau pendapatan unit, katalog, dan pembagian hasil dalam satu ruang kerja.<% } else if (currentUser.role === 'PROJECT_MANAGER') { %>Terima kebutuhan klien, bentuk tim, dan jaga mutu hasil sampai serah terima.<% } else { %>Kelola tiket, kirim bukti pekerjaan, dan pantau honor proyekmu.<% } %></p></div><div class="welcome-stamp"><span>TEFA</span><small>UNIT PRODUKSI<br>SMK TELKOM</small></div></section>
<section class="metric-grid" id="revenue">
  <% if (currentUser.role === 'ADMIN') { %>
    <article class="metric"><span class="metric-label">OMSET ORDER SELESAI</span><strong><%= formatRupiah(stats.revenue) %></strong><small><i class="dot-green"></i> <%= stats.completed %> proyek terserahterimakan</small><span class="metric-mark">↗</span></article>
    <article class="metric"><span class="metric-label">PROYEK BERJALAN</span><strong><%= stats.active %></strong><small>order aktif sedang dikerjakan</small><span class="metric-mark">◷</span></article>
    <article class="metric"><span class="metric-label">MENUNGGU VERIFIKASI</span><strong><%= stats.pending %></strong><small>perlu tindak lanjut project manager</small><span class="metric-mark">◌</span></article>
    <article class="metric metric-accent"><span class="metric-label">BAGI HASIL SAAT INI</span><strong><%= setting?.persentaseSiswa ?? 60 %><small>%</small></strong><small>siswa <span class="metric-divider">/</span> <%= setting?.persentaseKas ?? 40 %>% kas sekolah</small><span class="metric-mark">◇</span></article>
  <% } else if (currentUser.role === 'PROJECT_MANAGER') { %>
    <article class="metric"><span class="metric-label">ORDER AKTIF</span><strong><%= stats.active %></strong><small>proyek dalam pengerjaan</small><span class="metric-mark">◷</span></article>
    <article class="metric"><span class="metric-label">MENUNGGU VERIFIKASI</span><strong><%= stats.pending %></strong><small>order perlu dicek</small><span class="metric-mark">◌</span></article>
    <article class="metric"><span class="metric-label">SELESAI</span><strong><%= stats.completed %></strong><small><%= formatRupiah(stats.revenue) %> nilai order</small><span class="metric-mark">✓</span></article>
    <article class="metric metric-accent"><span class="metric-label">TIM TEKNISI</span><strong><%= students.length %></strong><small>siswa siap ditugaskan</small><span class="metric-mark">⌘</span></article>
  <% } else { %>
    <% const totalHonor = honors.reduce((sum, item) => sum + item.nominalHonor, 0); const paidHonor = honors.filter((item) => item.statusBayar === 'CAIR').reduce((sum, item) => sum + item.nominalHonor, 0); %>
    <article class="metric"><span class="metric-label">TIKET SAYA</span><strong><%= tasks.length %></strong><small><%= tasks.filter((task) => task.statusKanban !== 'DONE').length %> masih berjalan</small><span class="metric-mark">▤</span></article>
    <article class="metric"><span class="metric-label">TOTAL HONOR</span><strong><%= formatRupiah(totalHonor) %></strong><small>akumulasi seluruh proyek</small><span class="metric-mark">◇</span></article>
    <article class="metric"><span class="metric-label">SUDAH CAIR</span><strong><%= formatRupiah(paidHonor) %></strong><small>honor yang telah dibayarkan</small><span class="metric-mark">↗</span></article>
    <article class="metric metric-accent"><span class="metric-label">MENUNGGU PENCAIRAN</span><strong><%= formatRupiah(totalHonor - paidHonor) %></strong><small>menunggu proses unit TeFa</small><span class="metric-mark">◷</span></article>
  <% } %>
</section>

<% if (currentUser.role === 'ADMIN') { %>
<section class="section-block" id="services"><div class="section-heading"><div><span class="eyebrow">PENGELOLAAN UNIT</span><h3>Katalog layanan</h3></div><span class="section-count"><%= services.length %> LAYANAN AKTIF</span></div>
  <div class="split-layout"><form class="form-panel" action="/services" method="post"><h4>Tambah layanan jasa</h4><label>Nama layanan<input name="namaLayanan" placeholder="Jasa Pembuatan Landing Page" required></label><div class="form-row"><label>Kategori<select name="kategori"><option value="WEB">Web</option><option value="JARINGAN">Jaringan</option><option value="DESAIN">Desain</option><option value="HARDWARE">Hardware</option></select></label><label>Tarif dasar (Rp)<input name="hargaDasar" type="number" min="0" step="1000" placeholder="500000" required></label></div><label>Estimasi pengerjaan (hari)<input name="estimasiHari" type="number" min="1" value="7" required></label><button class="button button-primary" type="submit">＋ Simpan layanan</button></form>
  <div class="table-panel"><div class="table-heading"><h4>Layanan katalog</h4><span>KATALOG UNIT</span></div><div class="service-list"><% services.forEach((service) => { %><div class="service-row"><span class="service-icon"><%= service.kategori === 'WEB' ? '⌘' : service.kategori === 'JARINGAN' ? '⌁' : service.kategori === 'DESAIN' ? '◈' : '⚙' %></span><span class="service-name"><b><%= service.namaLayanan %> <%= service.active ? '' : '· ARSIP' %></b><small><%= service.kategori %> · <%= service.estimasiHari %> hari</small></span><strong><%= formatRupiah(service.hargaDasar) %></strong><details class="service-edit"><summary aria-label="Edit layanan">•••</summary><form action="/services/<%= service.id %>/update" method="post"><label>Nama layanan<input name="namaLayanan" value="<%= service.namaLayanan %>" required></label><label>Kategori<select name="kategori"><% ['WEB','JARINGAN','DESAIN','HARDWARE'].forEach((category) => { %><option value="<%= category %>" <%= category === service.kategori ? 'selected' : '' %>><%= category %></option><% }) %></select></label><div class="form-row"><label>Tarif<input type="number" name="hargaDasar" min="0" value="<%= service.hargaDasar %>" required></label><label>Hari<input type="number" name="estimasiHari" min="1" value="<%= service.estimasiHari %>" required></label></div><button class="button button-review" type="submit">Simpan perubahan</button></form><form action="/services/<%= service.id %>/toggle" method="post"><button class="button button-dark" type="submit"><%= service.active ? 'Arsipkan layanan' : 'Aktifkan layanan' %></button></form></details></div><% }) %></div></div></div>
</section>
<section class="section-block"><div class="section-heading"><div><span class="eyebrow">KEUANGAN PRODUKSI</span><h3>Atur pembagian hasil</h3></div><span class="section-count">TOTAL HARUS 100%</span></div><form class="settings-bar" action="/settings" method="post"><div><b>Honor siswa teknisi</b><small>Persentase dari nilai order untuk honor siswa.</small></div><label class="percent-input"><input type="number" min="0" max="100" name="persentaseSiswa" value="<%= setting?.persentaseSiswa ?? 60 %>" required><span>%</span></label><div class="settings-plus">+</div><div><b>Kas unit TeFa</b><small>Dialokasikan untuk operasional dan pengembangan.</small></div><label class="percent-input"><input type="number" min="0" max="100" name="persentaseKas" value="<%= setting?.persentaseKas ?? 40 %>" required><span>%</span></label><button class="button button-dark" type="submit">Simpan aturan</button></form></section>
<section class="section-block"><div class="section-heading"><div><span class="eyebrow">AKTIVITAS TERKINI</span><h3>Order produksi</h3></div></div><%- include('partials/order-table', { orders, formatRupiah, formatDate, showDocuments: false }) %></section>
<section class="section-block"><div class="section-heading"><div><span class="eyebrow">PEMBAYARAN SISWA</span><h3>Rekap honorarium</h3></div></div><div class="table-panel"><table><thead><tr><th>SISWA</th><th>ORDER / TUGAS</th><th>NOMINAL</th><th>STATUS</th><th>TANGGAL CAIR</th><th>AKSI</th></tr></thead><tbody><% if (!honors.length) { %><tr><td colspan="6" class="empty-row">Belum ada honor tercatat.</td></tr><% } %><% honors.forEach((honor) => { %><tr><td><b><%= honor.student.nama %></b></td><td><b><%= honor.task.order.nomorOrder %></b><small class="cell-sub"><%= honor.task.judulTugas %></small></td><td><b><%= formatRupiah(honor.nominalHonor) %></b></td><td><span class="status <%= honor.statusBayar === 'CAIR' ? 'status-done' : 'status-pending' %>"><%= honor.statusBayar %></span></td><td><%= honor.tglCair ? formatDate(honor.tglCair) : '—' %></td><td><% if (honor.statusBayar === 'PENDING') { %><form action="/honor/<%= honor.id %>/pay" method="post"><button class="button button-review" type="submit">Tandai cair ✓</button></form><% } else { %><span class="cell-sub">Tercatat</span><% } %></td></tr><% }) %></tbody></table></div></section>
<% } %>

<% if (currentUser.role === 'PROJECT_MANAGER') { %>
<section class="section-block" id="new-order"><div class="section-heading"><div><span class="eyebrow">PENERIMAAN PEKERJAAN</span><h3>Buat order & bentuk tim</h3></div><span class="section-count">ORDER BARU</span></div><form class="order-form" action="/orders" method="post"><div class="form-grid"><label>Nama klien / usaha<input name="namaKlien" placeholder="Contoh: UMKM Kopi Purnama" required></label><label>Kontak klien<input name="kontakKlien" placeholder="Nomor telepon / WhatsApp" required></label><label>Layanan jasa<select name="serviceId" required><option value="">Pilih layanan</option><% services.forEach((service) => { %><option value="<%= service.id %>"><%= service.namaLayanan %> · <%= formatRupiah(service.hargaDasar) %></option><% }) %></select></label><label>Nilai order (Rp)<input name="totalBiaya" type="number" min="0" placeholder="Gunakan tarif dasar bila kosong"></label><label>Deadline pengerjaan<input type="date" name="deadline" min="<%= new Date().toISOString().slice(0, 10) %>" required></label><label>Ringkasan kebutuhan<input name="deskripsi" placeholder="Tujuan, ruang lingkup, atau catatan klien"></label></div><div class="team-picker"><div><b>Tim teknisi yang ditugaskan</b><small>Pilih satu atau lebih siswa. Sistem membuat satu tiket per siswa.</small></div><div class="student-options"><% students.forEach((student) => { %><label class="check-option"><input type="checkbox" name="studentIds" value="<%= student.id %>"><span class="avatar avatar-small"><%= student.nama.slice(0, 1) %></span><span><b><%= student.nama %></b><small>NISN <%= student.nisn || '—' %></small></span></label><% }) %></div><button class="button button-primary" type="submit">Buat order & tugaskan tiket <span>→</span></button></div></form></section>
<section class="section-block" id="orders"><div class="section-heading"><div><span class="eyebrow">PENGENDALIAN MUTU</span><h3>Order & review deliverable</h3></div><span class="section-count"><%= orders.length %> ORDER</span></div><%- include('partials/order-table', { orders, formatRupiah, formatDate, showDocuments: true }) %></section>
<% } %>

<% if (currentUser.role === 'SISWA_TEKNISI') { %>
<section class="section-block" id="my-tasks"><div class="section-heading"><div><span class="eyebrow">PAPAN TUGAS PRIBADI</span><h3>Tiket pekerjaan saya</h3></div><span class="section-count"><%= tasks.length %> TIKET</span></div>
<div class="ticket-grid"><% if (!tasks.length) { %><div class="empty-state">Belum ada tiket tugas untuk akun ini.</div><% } %><% tasks.forEach((task) => { %><article class="ticket"><div class="ticket-top"><span class="mono-label"><%= task.order.nomorOrder %></span><span class="status status-<%= task.statusKanban.toLowerCase() %>"><%= task.statusKanban.replace('_', ' ') %></span></div><h4><%= task.judulTugas %></h4><p><%= task.deskripsi %></p><div class="ticket-client"><span>KLIEN</span><b><%= task.order.namaKlien %></b><span class="deadline">DEADLINE <%= formatDate(task.order.deadline) %></span></div><% if (task.statusKanban !== 'DONE') { %><form class="ticket-form" action="/tasks/<%= task.id %>/update" method="post"><label>Status pengerjaan<select name="statusKanban"><option value="TODO" <%= task.statusKanban === 'TODO' ? 'selected' : '' %>>TODO</option><option value="IN_PROGRESS" <%= task.statusKanban === 'IN_PROGRESS' ? 'selected' : '' %>>IN PROGRESS</option><option value="REVIEW" <%= task.statusKanban === 'REVIEW' ? 'selected' : '' %>>Kirim ke QA / Review</option></select></label><label>Tautan bukti hasil<input name="buktiHasilUrl" type="url" value="<%= task.buktiHasilUrl || '' %>" placeholder="https://github.com/username/project"></label><button class="button button-dark" type="submit">Simpan progres <span>→</span></button></form><% } else if (task.buktiHasilUrl) { %><a class="result-link" href="<%= task.buktiHasilUrl %>" target="_blank" rel="noopener">↗ Lihat hasil pekerjaan</a><% } %><div class="ticket-foot"><span>HONOR TIKET</span><b><%= task.honorarium ? formatRupiah(task.honorarium.nominalHonor) : 'Dihitung setelah disetujui' %></b></div></article><% }) %></div></section>
<section class="section-block" id="honor"><div class="section-heading"><div><span class="eyebrow">REKAP PRIBADI</span><h3>Saldo honorarium proyek</h3></div><span class="section-count">TRANSPARAN & TERCATAT</span></div><div class="table-panel honor-panel"><table><thead><tr><th>ORDER</th><th>PROYEK / KLIEN</th><th>NOMINAL</th><th>STATUS PEMBAYARAN</th><th>TANGGAL CAIR</th></tr></thead><tbody><% if (!honors.length) { %><tr><td class="empty-row" colspan="5">Honor akan tercatat saat hasil tugas disetujui project manager.</td></tr><% } %><% honors.forEach((honor) => { %><tr><td class="mono-label"><%= honor.task.order.nomorOrder %></td><td><b><%= honor.task.judulTugas %></b><small class="cell-sub"><%= honor.task.order.namaKlien %></small></td><td><b><%= formatRupiah(honor.nominalHonor) %></b></td><td><span class="status <%= honor.statusBayar === 'CAIR' ? 'status-done' : 'status-pending' %>"><%= honor.statusBayar %></span></td><td><%= honor.tglCair ? formatDate(honor.tglCair) : '—' %></td></tr><% }) %></tbody></table></div></section>
<% } %>
<%- include('partials/footer') %>
