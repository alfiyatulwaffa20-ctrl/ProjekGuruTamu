<div class="table-panel"><table><thead><tr><th>NOMOR / TANGGAL</th><th>KLIEN & LAYANAN</th><th>TIM / TIKET</th><th>NILAI ORDER</th><th>DEADLINE</th><th>STATUS</th><% if (showDocuments) { %><th>DOKUMEN</th><% } %></tr></thead><tbody>
<% if (!orders.length) { %><tr><td class="empty-row" colspan="<%= showDocuments ? 7 : 6 %>">Belum ada order tercatat.</td></tr><% } %>
<% orders.forEach((order) => { %><tr><td><b class="mono-label"><%= order.nomorOrder %></b><small class="cell-sub"><%= formatDate(order.tglMasuk) %></small></td><td><b><%= order.namaKlien %></b><small class="cell-sub"><%= order.service.namaLayanan %></small></td><td><div class="team-names"><% order.tasks.forEach((task) => { %><span><%= task.student.nama %> <i class="status-mini status-<%= task.statusKanban.toLowerCase() %>"><%= task.statusKanban.replace('_', ' ') %></i></span><% }) %></div>
<% if (showDocuments) { order.tasks.filter((task) => task.statusKanban === 'REVIEW').forEach((task) => { %><form class="review-form" action="/tasks/<%= task.id %>/approve" method="post"><input name="catatanRevisi" placeholder="Catatan review (opsional)"><button type="submit" class="button button-review">Setujui hasil <span>✓</span></button></form><% }) } %></td><td><b><%= formatRupiah(order.totalBiaya) %></b></td><td><%= formatDate(order.deadline) %></td><td><span class="status <%= order.status === 'SELESAI' ? 'status-done' : order.status === 'BATAL' ? 'status-cancelled' : order.status === 'PENDING' ? 'status-pending' : 'status-progress' %>"><%= order.status.replace('_', ' ') %></span></td>
<% if (showDocuments) { %><td><div class="document-links"><a href="/orders/<%= order.id %>/invoice" target="_blank">Invoice ↗</a><a href="/orders/<%= order.id %>/ba" target="_blank">Berita acara ↗</a></div></td><% } %></tr><% if (showDocuments && order.status === 'PENDING') { %><tr class="verify-row"><td colspan="7"><b>Verifikasi order <%= order.nomorOrder %></b><span> Pastikan ruang lingkup dan penugasan sudah sesuai.</span><form action="/orders/<%= order.id %>/verify" method="post"><button class="button button-review" type="submit">Verifikasi & mulai pengerjaan <span>→</span></button></form></td></tr><% } %><% }) %>
</tbody></table></div>
